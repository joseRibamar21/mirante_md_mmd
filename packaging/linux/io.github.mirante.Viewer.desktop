[Desktop Entry]
Type=Application
Name=Mirante
GenericName=Markdown Viewer
GenericName[pt]=Visualizador de Markdown
GenericName[pt_BR]=Visualizador de Markdown
Comment=View and edit Markdown (.md), LaTeX (.tex) and Typst (.typ) files, Mermaid (.mmd) and Graphviz (.gv) diagrams and plain text (.txt)
Comment[pt]=Visualize e edite arquivos Markdown (.md), LaTeX (.tex) e Typst (.typ), diagramas Mermaid (.mmd) e Graphviz (.gv) e texto simples (.txt)
Comment[pt_BR]=Visualize e edite arquivos Markdown (.md), LaTeX (.tex) e Typst (.typ), diagramas Mermaid (.mmd) e Graphviz (.gv) e texto simples (.txt)
Exec=mirante %F
Icon=mirante
Terminal=false
Categories=Utility;Viewer;TextTools;GTK;
Keywords=markdown;md;latex;tex;typst;typ;bibtex;bib;mermaid;mmd;graphviz;dot;gv;diagram;mind map;mindmap;viewer;
Keywords[pt]=markdown;md;latex;tex;typst;typ;bibtex;bib;mermaid;mmd;graphviz;dot;gv;diagrama;mapa mental;mindmap;visualizador;
Keywords[pt_BR]=markdown;md;latex;tex;typst;typ;bibtex;bib;mermaid;mmd;graphviz;dot;gv;diagrama;mapa mental;mindmap;visualizador;
MimeType=text/markdown;text/x-markdown;text/vnd.mermaid;text/vnd.graphviz;text/x-tex;text/x-typst;text/x-bibtex;text/plain;
StartupNotify=true
StartupWMClass=mirante
DBusActivatable=false
