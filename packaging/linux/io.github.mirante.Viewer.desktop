[Desktop Entry]
Type=Application
Name=Mirante
GenericName=Visualizador de Markdown
Comment=Visualize e edite arquivos Markdown (.md) e diagramas Mermaid (.mmd)
Exec=mirante %F
Icon=mirante
Terminal=false
Categories=Utility;Viewer;TextTools;GTK;
Keywords=markdown;md;mermaid;mmd;diagrama;mapa mental;mindmap;viewer;
MimeType=text/markdown;text/x-markdown;text/vnd.mermaid;
StartupNotify=true
StartupWMClass=mirante
DBusActivatable=false
